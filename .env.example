# Gemini API (AI Studio) key — https://aistudio.google.com/apikey
GOOGLE_API_KEY=
GOOGLE_GENAI_USE_VERTEXAI=False

# Model config (per §11 of docs/feature.prd) — swap freely, all Gemini-native.
# gemini-3-flash (the PRD's original pick) 404s on the Developer API — these
# ids were confirmed against `client.models.list()` for a real API key.
# SPECIALIST_MODEL is gemini-2.5-flash, not -flash-lite: -lite intermittently
# returned empty (zero-token) responses after large tool results in testing.
SPECIALIST_MODEL=gemini-2.5-flash
SUPERVISOR_MODEL=gemini-2.5-flash
JUDGE_MODEL=gemini-2.5-flash-lite
EMBEDDING_MODEL=gemini-embedding-001

# Which scenario fixture the supervisor auto-loads if none is set yet
SCENARIO_PATH=scenarios/demand_spike.json
